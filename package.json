{
  "name": "sublime-clone",
  "version": "1.0.0",
  "description": "A Sublime Text 4 inspired code editor",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icon": "electron scripts/generate-icon.js",
    "pack": "electron-packager . 'Sublime Text' --platform=darwin --arch=arm64 --icon=build/icon --out=dist --overwrite --app-bundle-id=com.sublimetext.clone --app-category-type=public.app-category.developer-tools --prune=true",
    "dmg": "node scripts/build-dmg.js"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^28.0.0"
  },
  "dependencies": {
    "monaco-editor": "^0.44.0"
  },
  "allowScripts": {
    "electron@28.3.3": true
  }
}
